# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Data ---
# PlantVillage is large — do not commit the raw images.
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Model artifacts ---
artifacts/checkpoints/**
!artifacts/checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx

# --- Experiment tracking ---
artifacts/mlruns/**
!artifacts/mlruns/.gitkeep
mlruns/
mlflow.db

# --- Logs ---
logs/
*.log

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Next.js / Node (web/) ---
# The Next.js scaffold should ship a web/.gitignore but we don't rely on it;
# ignore the heavy generated stuff at the root so nothing leaks into the repo.
web/node_modules/
web/.next/
web/out/
web/build/
web/dist/
web/.vercel/
web/.env*.local
web/next-env.d.ts
web/tsconfig.tsbuildinfo
web/.turbo/
web/coverage/
web/*.log
web/.DS_Store

# --- Local-only demo / test images ---
# Test set sampled from PlantVillage for demo browsing (reproducible from
# scripts/copy_test_samples.py with seed=42).
data/test_demo/
# Internet leaf photos Quinn collected for OOD testing — not part of the
# training data and not redistributable.
data/outside_data/
